{
  "name": "@luisbedoia/coolprop-rs-wasm",
  "version": "0.1.0",
  "description": "Browser/Wasm bridge to coolprop-rs \u2014 a Rust thermophysical property library powered by CoolProp.",
  "license": "MIT",
  "author": "Luis Arias <ariasb.luis@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/luisbedoia/coolprop-rs.git",
    "directory": "wasm-pkg"
  },
  "homepage": "https://github.com/luisbedoia/coolprop-rs#readme",
  "keywords": [
    "coolprop",
    "thermodynamics",
    "wasm",
    "emscripten",
    "thermophysical"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
